# =====================================================================
# 仓库根级忽略规则（子项目各自还有 .gitignore，随目录生效）
# =====================================================================

# npm 本地缓存（nvm4w 等工具会在项目目录下生成）
.npm-cache/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 本地环境变量（含密码，禁止入库）
.env
.env.local
*.local

# 日志
*.log
logs/

# 构建产物兜底：子项目 .gitignore 已覆盖，此处防止根目录误建
target/
dist/
node_modules/

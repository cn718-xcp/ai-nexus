# AI Nexus 容器编排环境变量模板
# 使用：cp deploy/.env.example .env  然后按需修改

# ---------------- 应用 ----------------
# 宿主机访问端口（默认 8081，避免与本地开发 8080 冲突）
APP_PORT=8081
# 宿主机 Ollama 地址（容器内通过 host.docker.internal 访问宿主机）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------- MySQL ----------------
MYSQL_DATABASE=ai_nexus
MYSQL_USER=ainexus
MYSQL_PASSWORD=ainexus123
MYSQL_ROOT_PASSWORD=root123
# 宿主机访问端口（避免与本地 3306 冲突）
MYSQL_PORT=33061

# ---------------- Redis ----------------
REDIS_PASSWORD=
# 宿主机访问端口（避免与本地 6379 冲突）
REDIS_PORT=16379

# ---------------- Milvus ----------------
MILVUS_USER=root
MILVUS_PASSWORD=milvus
# 宿主机访问端口（避免与本地 19530 冲突）
MILVUS_PORT=19531
MILVUS_METRICS_PORT=19091

# ---------------- MinIO（Milvus 对象存储依赖） ----------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=19090
